# Variables de entorno (configúralas en Vercel → Settings → Environment Variables)
# Nunca pongas valores reales en este archivo: el repositorio es público.

# --- Públicas (se ven en el navegador) ---
VITE_PAYPAL_CLIENT_ID=""        # Client ID de tu app de PayPal (sin esto, PayPal no aparece)
VITE_ZELLE_RECIPIENT=""         # correo o teléfono registrado en Zelle (sin esto, Zelle no aparece)
VITE_ZELLE_NAME=""              # nombre que aparece en Zelle
VITE_CASHAPP_TAG=""             # tu $Cashtag, ej: $MiTienda (sin esto, Cash App no aparece)
VITE_CONTACT_WHATSAPP=""        # ej: 18095551234
VITE_CONTACT_EMAIL=""           # correo de atención al cliente
VITE_RETURN_DAYS="7"
VITE_DELIVERY_ESTIMATE="2 a 5 días hábiles"

# --- Secretas (solo servidor, NUNCA con prefijo VITE_) ---
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_MODE="sandbox"           # "sandbox" para pruebas, "live" para cobrar de verdad
SUPABASE_SERVICE_KEY=""         # Supabase → Project Settings → API Keys → secret key
